%% Figure 3: Agentic Router Decision Flowchart
flowchart TD
    Query(["📥 Incoming Legal Query<br/>(User Role + Context)"]) --> Search["🔍 ChromaDB Retrieval<br/>(Fetch Top-4 Chunks)"]
    Search --> Decision{"Top Similarity<br/>&ge; 0.75?"}
    
    %% Local Path
    Decision -->|"Yes (&ge; 0.75)<br/>In-Domain"| Local["🔒 Local Model (Ollama / llama3)<br/>Synthesize with Verified Context"]
    Local --> LocalOutput["✅ Output: local_rag<br/>Confidence &ge; 0.75 + Citations Array"]
    
    %% Cloud Path
    Decision -->|"No (< 0.75)<br/>Out-of-Domain"| Cloud["🌐 Gemini 2.5 Flash Fallback<br/>Augment with Live Google Search"]
    Cloud --> CloudOutput["✅ Output: gemini_fallback<br/>Confidence < 0.75 + Live Grounding"]
    
    LocalOutput --> Return(["📤 Send Response to React Frontend"])
    CloudOutput --> Return

    classDef query fill:#f1f5f9,stroke:#64748b,stroke-width:2px;
    classDef step fill:#eff6ff,stroke:#3b82f6,stroke-width:2px;
    classDef gate fill:#fef3c7,stroke:#d97706,stroke-width:3px;
    classDef local fill:#dcfce7,stroke:#16a34a,stroke-width:2px;
    classDef cloud fill:#e0f2fe,stroke:#0284c7,stroke-width:2px;
    
    class Query,Return query;
    class Search step;
    class Decision gate;
    class Local,LocalOutput local;
    class Cloud,CloudOutput cloud;
