%% Figure 1: Simple End-to-End System Architecture
graph LR
    User(["👤 User / Client"]) --> UI["🖥️ React 18 UI<br/>(Tailwind CSS)"]
    UI --> Router["⚡ FastAPI Router<br/>(backend/main.py)"]
    
    Router --> Chroma[("📚 ChromaDB<br/>Vector Store")]
    Chroma --> Gate{"Similarity Score<br/>&ge; 0.75?"}
    
    %% In-Domain Local Path
    Gate -->|"Yes (&ge; 0.75)<br/>In-Domain"| Local["🔒 Local RAG<br/>(Ollama / llama3)"]
    Local -->|"Verified Answer<br/>+ Citations"| Response["📋 Final Response<br/>(source: local_rag)"]
    
    %% Out-of-Domain Cloud Path
    Gate -->|"No (< 0.75)<br/>Out-of-Domain"| Cloud["🌐 Gemini Cloud<br/>(Search Grounding)"]
    Cloud -->|"Live Statute<br/>Analysis"| Response2["📋 Final Response<br/>(source: gemini_fallback)"]
    
    Response --> UI
    Response2 --> UI

    classDef client fill:#e0f2fe,stroke:#0284c7,stroke-width:2px;
    classDef router fill:#ede9fe,stroke:#7c3aed,stroke-width:2px;
    classDef gate fill:#fef3c7,stroke:#d97706,stroke-width:2px;
    classDef local fill:#dcfce7,stroke:#16a34a,stroke-width:2px;
    classDef cloud fill:#f0f9ff,stroke:#0ea5e9,stroke-width:2px;
    
    class User,UI client;
    class Router,Chroma router;
    class Gate gate;
    class Local,Response local;
    class Cloud,Response2 cloud;
